{
  description = "QMK firmware development environment";

  inputs = {
    # Pinned to 22.05 to match the age of this firmware: newer qmk CLI
    # releases drop the appdirs dependency the firmware's python lib needs,
    # and newer avr-gcc versions fail to build older QMK code
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-22.05";
    flake-utils.url = "github:numtide/flake-utils";
  };

  outputs = { self, nixpkgs, flake-utils }:
    flake-utils.lib.eachDefaultSystem (system:
      let
        pkgs = import nixpkgs { inherit system; };

        # Converts a 128x32 PNG into a C header holding the raw bytes for
        # oled_write_raw_P, in the SSD1306 layout: 4 pages of 128 bytes, each
        # byte a vertical strip of 8 pixels with the lowest bit at the top.
        # Pixels with brightness >= 128 are lit.
        #
        # With cw or ccw, the input is a 32x128 portrait image for a screen
        # mounted vertically, rotated that way first to become 128x32.
        png2oled = pkgs.writeScriptBin "png2oled" ''
          #!${pkgs.python3.withPackages (ps: [ ps.pillow ])}/bin/python3
          import os
          import sys
          from PIL import Image

          if len(sys.argv) not in (4, 5):
              sys.exit("usage: png2oled <input.png> <array_name> <output.h> [cw|ccw]")
          src, name, out = sys.argv[1:4]
          rotate = sys.argv[4] if len(sys.argv) == 5 else None

          img = Image.open(src).convert("L")
          if rotate is None:
              if img.size != (128, 32):
                  sys.exit(f"{src}: must be 128x32 pixels, got {img.size[0]}x{img.size[1]}")
          elif rotate in ("cw", "ccw"):
              if img.size != (32, 128):
                  sys.exit(f"{src}: must be 32x128 pixels (portrait), got {img.size[0]}x{img.size[1]}")
              img = img.transpose(Image.Transpose.ROTATE_270 if rotate == "cw" else Image.Transpose.ROTATE_90)
          else:
              sys.exit(f"rotation must be cw or ccw, got {rotate}")

          data = []
          for page in range(4):
              for x in range(128):
                  b = 0
                  for bit in range(8):
                      if img.getpixel((x, page * 8 + bit)) >= 128:
                          b |= 1 << bit
                  data.append(b)

          lines = [", ".join(f"0x{b:02x}" for b in data[i:i + 16]) for i in range(0, len(data), 16)]
          with open(out, "w") as f:
              f.write(f"// Generated by png2oled from {os.path.basename(src)}. Edit the PNG, not this file.\n")
              f.write("#pragma once\n\n")
              f.write(f"const char {name}[] PROGMEM = {{\n  " + ",\n  ".join(lines) + "\n};\n")
        '';

        # Builds the mackenzie keymap and copies the firmware into the
        # keymap's output folder (a symlink to a Windows folder for flashing).
        # The OLED logos are regenerated from art/*.png first. Both screens
        # are mounted vertically: the left one shows the top of the image
        # facing left, the right one facing right, so the portrait art is
        # rotated the opposite way to come out upright.
        build-mackenzie = pkgs.writeShellScriptBin "build-mackenzie" ''
          set -euo pipefail
          cd "$(git rev-parse --show-toplevel)"
          keymap=keyboards/lily58/keymaps/mackenzie
          ${png2oled}/bin/png2oled "$keymap/art/left.png" left_logo "$keymap/left_logo.h" cw
          ${png2oled}/bin/png2oled "$keymap/art/right.png" right_logo "$keymap/right_logo.h" ccw
          make lily58:mackenzie
          cp lily58_rev1_mackenzie.hex keyboards/lily58/keymaps/mackenzie/output/
          echo "Copied lily58_rev1_mackenzie.hex to keyboards/lily58/keymaps/mackenzie/output/"
        '';
      in
      {
        devShells.default = pkgs.mkShell {
          name = "qmk-firmware";

          # The qmk package brings the qmk CLI along with the AVR/ARM
          # toolchains and flashing utilities it depends on
          packages = with pkgs; [
            qmk
            clang-tools
            gnumake
            git
            build-mackenzie
            png2oled
          ];

          shellHook = ''
            # Prevent the avr-gcc wrapper from picking up host GCC flags
            unset NIX_CFLAGS_COMPILE_FOR_TARGET
            export QMK_HOME="$PWD"
          '';
        };
      });
}
